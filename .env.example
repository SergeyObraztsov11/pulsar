DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app?schema=public"
NUXT_SESSION_PASSWORD="dev-session-password-at-least-32-chars"

# MinIO (docker compose). Консоль: http://127.0.0.1:9001
NUXT_S3_ENDPOINT="http://127.0.0.1:9000"
NUXT_S3_REGION="us-east-1"
NUXT_S3_ACCESS_KEY="minio"
NUXT_S3_SECRET_KEY="minio12345"
NUXT_S3_BUCKET="media"

